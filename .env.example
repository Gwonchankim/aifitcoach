# --- API ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afc
# 마이그레이션 전용 DSN. Neon 배포에서는 non-pooled direct URL을 사용한다.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/afc
# 로컬 개발·테스트 전용. production에서는 AUTH_MODE=dev-user가 부팅을 거부한다.
AUTH_MODE=dev-user
DEV_USER_ID=00000000-0000-4000-8000-000000000001
# CORS 허용 origin(쉼표로 여러 개). 쿠키 세션을 쓰므로 `*` 는 쓸 수 없다.
WEB_ORIGIN=http://localhost:3000
# 민감 건강필드(AES-256-GCM) 암호화 키 = 32바이트의 base64. 생성: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# production에서만 필요. 32바이트 이상 무작위 값을 Secret Manager에서 주입하고 절대 커밋하지 않는다.
OWNER_RECOVERY_CODE=
# --- Payments (Korean PG) ---
PORTONE_API_KEY=
PORTONE_WEBHOOK_SECRET=
# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
# Vercel 서버 환경 변수: https://<Cloud Run service>.run.app (브라우저에 노출하지 않는다).
API_PROXY_ORIGIN=
