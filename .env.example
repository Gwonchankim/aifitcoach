# --- API ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afc
REDIS_URL=redis://localhost:6379
# 테스트 단계 고정 개발용 사용자(users.id 는 uuid 유지). 인증 도입 시 이 값만 교체한다.
DEV_USER_ID=00000000-0000-4000-8000-000000000001
# CORS 허용 origin(쉼표로 여러 개). 쿠키 세션을 쓰므로 `*` 는 쓸 수 없다.
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me
CSRF_SECRET=change-me
# 민감 건강필드(AES-256-GCM) 암호화 키 = 32바이트의 base64. 생성: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# --- Social OAuth ---
KAKAO_CLIENT_ID=
NAVER_CLIENT_ID=
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# --- Payments (Korean PG) ---
PORTONE_API_KEY=
PORTONE_WEBHOOK_SECRET=
# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
