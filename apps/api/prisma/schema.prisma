// docs/DATA_MODEL.md 의 요약 DDL을 1:1로 옮긴 스키마.
// DB 네이밍은 snake_case(@map/@@map), Prisma 모델명은 PascalCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------

enum Sex {
  male
  female
  other

  @@map("sex")
}

enum Goal {
  diet
  hypertrophy
  strength

  @@map("goal")
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced

  @@map("experience_level")
}

enum MovementPattern {
  squat
  hinge
  lunge
  knee_extension
  knee_flexion
  calf
  horizontal_push
  vertical_push
  horizontal_pull
  vertical_pull
  elbow_extension
  elbow_flexion
  shoulder_isolation
  core

  @@map("movement_pattern")
}

enum Mechanic {
  compound
  isolation

  @@map("mechanic")
}

enum Region {
  upper
  lower
  core

  @@map("region")
}

enum Equipment {
  barbell
  dumbbell
  machine
  cable
  bodyweight
  ez_bar

  @@map("equipment")
}

enum Difficulty {
  beginner
  intermediate
  advanced

  @@map("difficulty")
}

enum Metric {
  reps
  time

  @@map("metric")
}

enum SessionStatus {
  scheduled
  in_progress
  completed

  @@map("session_status")
}

// 세션이 프로그램 계획에서 나왔는지(planned), 사용자가 그날 즉석으로 만든 것인지(ad_hoc).
// 즉석 세션은 focus 가 부위명(chest/legs...)이라 focus 만으로는 계획 세션과 구분되지 않는다.
enum SessionOrigin {
  planned
  ad_hoc

  @@map("session_origin")
}

enum PlanTier {
  free
  pro

  @@map("plan_tier")
}

enum SubscriptionStatus {
  trial
  active
  grace
  expired
  cancelled

  @@map("subscription_status")
}

enum SyncEntityType {
  performed_set
  session
  profile

  @@map("sync_entity_type")
}

enum SyncOp {
  upsert
  delete

  @@map("sync_op")
}

enum SyncStatus {
  pending
  applied
  conflict

  @@map("sync_status")
}

enum CalibrationStatus {
  not_started
  in_progress
  graduated
  stale

  @@map("calibration_status")
}

// ---------- models ----------

model User {
  id              String          @id @default(uuid()) @db.Uuid
  sex             Sex
  birthYear       Int             @map("birth_year")
  heightCm        Decimal         @map("height_cm") @db.Decimal(5, 1)
  weightKg        Decimal         @map("weight_kg") @db.Decimal(5, 1)
  // 건강 민감정보: 앱 레벨 암호화 저장(v1:iv:tag:ciphertext) — SECURITY_PIPA.md
  bodyFatPct      String?         @map("body_fat_pct")
  goal            Goal
  experienceLevel ExperienceLevel @map("experience_level")
  constraints     Json
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  consents         Consent[]
  programs         Program[]
  estimated1rm     Estimated1rm[]
  muscleWeeklyLoad MuscleWeeklyLoad[]
  subscription     Subscription?
  syncMutations    SyncMutation[]
  rirCalibration   UserRirCalibration?
  calibrationSets  CalibrationSet[]

  @@map("users")
}

model Consent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  version   String
  granted   Boolean
  grantedAt DateTime @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("consents")
}

model Program {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  goal              Goal
  daysPerWeek       Int      @map("days_per_week")
  minutesPerDay     Int      @map("minutes_per_day")
  splitType         String   @map("split_type")
  rulesVersion      String   @map("rules_version")
  // 생성 시점의 주간 템플릿(openapi Program.sessions). 세션은 이 템플릿의 인스턴스이고
  // 세션 편집(F5)은 세션 스코프라 템플릿에 반영되지 않는다(DATA_MODEL.md 미기재 — STEP 4 추가).
  template          Json     @default("[]")
  // pain_areas 로 후보에서 뺀 운동과 사유(openapi Program.excluded_exercises, SAFETY_PAIN_MAPPING.md 규칙 3).
  excludedExercises Json     @default("[]") @map("excluded_exercises")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id])
  sessions WorkoutSession[]

  @@index([userId], map: "ix_programs_user")
  @@map("programs")
}

model Exercise {
  id                 String          @id
  nameKo             String          @map("name_ko")
  nameEn             String          @map("name_en")
  movementPattern    MovementPattern @map("movement_pattern")
  mechanic           Mechanic
  region             Region
  primaryMuscles     String[]        @map("primary_muscles")
  secondaryMuscles   String[]        @map("secondary_muscles")
  equipment          Equipment
  difficulty         Difficulty
  metric             Metric
  // metric=reps 는 reps 범위를, metric=time 은 time 범위를 채운다(시드 e_plank 참고).
  defaultRepsLow     Int?            @map("default_reps_low")
  defaultRepsHigh    Int?            @map("default_reps_high")
  defaultTimeLowSec  Int?            @map("default_time_low_sec")
  defaultTimeHighSec Int?            @map("default_time_high_sec")
  defaultStepKg      Decimal?        @map("default_step_kg") @db.Decimal(5, 2)
  unilateral         Boolean
  substitutions      String[]
  cues               String[]
  media              Json

  plannedSets     PlannedSet[]
  estimated1rm    Estimated1rm[]
  calibrationSets CalibrationSet[]

  @@map("exercises")
}

model WorkoutSession {
  id              String        @id @default(uuid()) @db.Uuid
  programId       String        @map("program_id") @db.Uuid
  scheduledDate   DateTime      @map("scheduled_date") @db.Date
  // openapi Program.sessions[].focus / DashboardSummary.routine_summary.focus 가 required 라
  // 세션의 분할 포커스(upper/lower/push/pull/legs/full_body)를 저장한다(DATA_MODEL.md 미기재 — STEP 4 추가).
  focus           String
  status          SessionStatus
  // 즉석 세션(F8-1)은 계획이 아니다 → 스트릭·주간 완료율의 "계획된 날"에서 빠진다
  // (DATA_MODEL.md 미기재 — 대시보드 결함 D-1 수정으로 추가).
  origin          SessionOrigin @default(planned)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(3)
  // sessionFeedback.pain 은 JSON 안에 암호화 저장(v1:iv:tag:ciphertext) — SECURITY_PIPA.md
  sessionFeedback Json?         @map("session_feedback")
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  program     Program      @relation(fields: [programId], references: [id])
  plannedSets PlannedSet[]

  @@index([programId, scheduledDate], map: "ix_sessions_prog_date")
  @@map("workout_sessions")
}

model PlannedSet {
  id                String   @id @default(uuid()) @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  exerciseId        String   @map("exercise_id")
  // 세션 안에서 운동이 놓이는 순서. openapi AddExerciseRequest.position 을 구현하려면
  // 세션 스코프 운동 순서가 필요한데 DATA_MODEL.md 에 없다(STEP 4 추가). set_no 는 운동 내 세트 번호다.
  orderIndex        Int      @map("order_index")
  setNo             Int      @map("set_no")
  // metric=time 종목(e_plank)은 반복·RIR 축이 없다 → 반복 목표는 NULL 이고 시간 목표를 채운다.
  targetRepsLow     Int?     @map("target_reps_low")
  targetRepsHigh    Int?     @map("target_reps_high")
  targetRir         Int?     @map("target_rir")
  restSec           Int      @map("rest_sec")
  targetTimeLowSec  Int?     @map("target_time_low_sec")
  targetTimeHighSec Int?     @map("target_time_high_sec")
  // NULL = 자체중량(맨몸·시간 종목) — 추가 부하를 처방하지 않는다(RECOMMENDATION_ENGINE.md).
  recommendedWeight Decimal? @map("recommended_weight") @db.Decimal(6, 2)
  recommendedReps   Int?     @map("recommended_reps")
  reasonCode        String   @map("reason_code")
  confidence        Decimal  @db.Decimal(3, 2)
  rulesVersion      String   @map("rules_version")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session       WorkoutSession @relation(fields: [sessionId], references: [id])
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  performedSets PerformedSet[]

  @@unique([sessionId, exerciseId, setNo], map: "ux_planned_session_exercise_set")
  @@index([sessionId], map: "ix_planned_session")
  @@map("planned_sets")
}

model PerformedSet {
  id            String   @id @default(uuid()) @db.Uuid
  plannedSetId  String   @map("planned_set_id") @db.Uuid
  // metric=reps 는 actual_weight/actual_reps, metric=time(e_plank)은 actual_time_sec 를 채운다.
  // 서로 배타적이라 양쪽 다 NULL 허용이다.
  actualWeight  Decimal? @map("actual_weight") @db.Decimal(6, 2)
  actualReps    Int?     @map("actual_reps")
  actualRir     Int?     @map("actual_rir")
  actualTimeSec Int?     @map("actual_time_sec")
  // 건강 민감정보: 앱 레벨 암호화 저장(v1:iv:tag:ciphertext) — SECURITY_PIPA.md
  painScore     String?  @map("pain_score")
  completed     Boolean
  // client_id = 오프라인 동기화 멱등 키
  clientId      String   @map("client_id") @db.Uuid
  performedAt   DateTime @map("performed_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plannedSet PlannedSet @relation(fields: [plannedSetId], references: [id])

  @@unique([clientId], map: "ux_performed_client")
  @@index([plannedSetId], map: "ix_performed_planned")
  @@map("performed_sets")
}

model Estimated1rm {
  userId     String   @map("user_id") @db.Uuid
  exerciseId String   @map("exercise_id")
  e1rm       Decimal  @db.Decimal(6, 2)
  method     String
  computedAt DateTime @map("computed_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@id([userId, exerciseId, computedAt])
  @@index([userId, exerciseId, computedAt(sort: Desc)], map: "ix_e1rm_user_ex")
  @@map("estimated_1rm")
}

model MuscleWeeklyLoad {
  userId     String   @map("user_id") @db.Uuid
  weekStart  DateTime @map("week_start") @db.Date
  muscle     String
  hardSets   Int      @map("hard_sets")
  volumeLoad Decimal  @map("volume_load") @db.Decimal(10, 2)
  avgRir     Decimal  @map("avg_rir") @db.Decimal(3, 1)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, weekStart, muscle])
  @@index([userId, weekStart], map: "ix_mwl_user_week")
  @@map("muscle_weekly_load")
}

model Subscription {
  userId        String             @id @map("user_id") @db.Uuid
  tier          PlanTier
  provider      String
  billingKeyRef String?            @map("billing_key_ref")
  status        SubscriptionStatus
  startedAt     DateTime?          @map("started_at") @db.Timestamptz(3)
  renewsAt      DateTime?          @map("renews_at") @db.Timestamptz(3)
  trialEndsAt   DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model SyncMutation {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  entityType      SyncEntityType @map("entity_type")
  entityId        String         @map("entity_id")
  op              SyncOp
  payload         Json
  clientUpdatedAt DateTime       @map("client_updated_at") @db.Timestamptz(3)
  appliedAt       DateTime?      @map("applied_at") @db.Timestamptz(3)
  status          SyncStatus

  user User @relation(fields: [userId], references: [id])

  @@map("sync_mutations")
}

model UserRirCalibration {
  userId           String            @id @map("user_id") @db.Uuid
  biasOverall      Decimal           @map("bias_overall") @db.Decimal(3, 2)
  biasByRegion     Json              @map("bias_by_region")
  confidence       Decimal           @db.Decimal(3, 2)
  samples          Int
  lastCalibratedAt DateTime?         @map("last_calibrated_at") @db.Timestamptz(3)
  status           CalibrationStatus

  user User @relation(fields: [userId], references: [id])

  @@map("user_rir_calibration")
}

model CalibrationSet {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  exerciseId     String   @map("exercise_id")
  sessionDay     Int      @map("session_day")
  predictedRir   Int      @map("predicted_rir")
  amrapExtraReps Int      @map("amrap_extra_reps")
  actualRir      Int      @map("actual_rir")
  biasSample     Decimal  @map("bias_sample") @db.Decimal(3, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@map("calibration_set")
}
